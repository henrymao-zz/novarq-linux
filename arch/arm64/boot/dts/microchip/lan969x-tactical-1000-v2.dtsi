/dts-v1/;

#include "lan969x-tactical-1000.dtsi"

/ {
	cpu_gpio_pwm: cpu-gpio-pwm {
		#pwm-cells = <3>;
		compatible = "pwm-gpio";
		gpios = <&gpio 25 GPIO_ACTIVE_LOW>;
	};

	cpu-pwm-fan {
		compatible = "pwm-fan";
		pinctrl-names = "default";
		pinctrl-0 = <&fan_pins>;
		pwms = <&cpu_gpio_pwm 0 40000 0>;
	};

	case_gpio_pwm: case-gpio-pwm {
		#pwm-cells = <3>;
		compatible = "pwm-gpio";
		gpios = <&gpio 65 GPIO_ACTIVE_LOW>;
	};

	case-pwm-fan {
		compatible = "pwm-fan";
		pinctrl-names = "default";
		pinctrl-0 = <&case_fan_pins>;
		pwms = <&case_gpio_pwm 0 40000 0>;
	};
};

&port0 {
	phy-handle = <&phy7>;
};

&port1 {
	phy-handle = <&phy6>;
};

&port2 {
	phy-handle = <&phy5>;
};

&port3 {
	phy-handle = <&phy4>;
};

&port4 {
	phy-handle = <&phy11>;
};

&port5 {
	phy-handle = <&phy10>;
};

&port6 {
	phy-handle = <&phy9>;
};

&port7 {
	phy-handle = <&phy8>;
};

&port8 {
	phy-handle = <&phy15>;
};

&port9 {
	phy-handle = <&phy14>;
};

&port10 {
	phy-handle = <&phy13>;
};

&port11 {
	phy-handle = <&phy12>;
};

&port12 {
